const RX={};
for(const[l,i]of[['fr',1],['en',2]])RX[l]=D.slice().sort((a,b)=>b[0].length-a[0].length).map(r=>[new RegExp('(?<![\\u0600-\\u06FF])'+r[0].replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'(?![\\u0600-\\u06FF])','g'),r[i]]);
function tr(s){if(S.lang==='ar')return s;let o=s;for(const[r,v]of RX[S.lang])o=o.replace(r,()=>v);return o.replace(/←/g,'→')}
function applyLang(root=app){const h=document.documentElement;h.lang=S.lang;h.dir=LANGS[S.lang];if(S.lang==='ar')return;
const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);for(let n;n=w.nextNode();)n.nodeValue=tr(n.nodeValue);
root.querySelectorAll('[placeholder]').forEach(e=>e.placeholder=tr(e.placeholder))}
const langSw=()=>`<div class="lang">${Object.keys(LANGS).map(l=>`<button data-act="lang" data-v="${l}" class="${S.lang===l?'on':''}">${LBL[l]}</button>`).join('')}</div>`;
// واجهة التطبيق: راكبة / سائقة / إدارة
const $=s=>document.querySelector(s),app=$('#app'),PL=CFG.places,pn=i=>PL[i].n;
const S={lang:localStorage.sl_lang||'ar',tab:'home',mode:'login',role:'passenger',from:0,to:1,when:'now',date:'',star:5,atab:'stats'};
const fmt=t=>new Date(t).toLocaleString(S.lang==='ar'?'ar-DZ':S.lang==='fr'?'fr-FR':'en-GB',{dateStyle:'short',timeStyle:'short'}),money=n=>`${n} ${CFG.currency}`;
const ST={searching:'بحث عن سائقة',accepted:'السائقة في الطريق',ongoing:'الرحلة جارية',completed:'مكتملة',cancelled:'ملغاة'};
const stars=n=>n==='—'?'—':'★'.repeat(Math.round(n))+'☆'.repeat(5-Math.round(n))+' '+n;
const avg=(uid,k)=>{const a=API.rides().filter(r=>r[k==='ratingD'?'driverId':'passengerId']===uid&&r[k]).map(r=>r[k].s);return a.length?(a.reduce((x,y)=>x+y)/a.length).toFixed(1):'—'};
const prog=r=>r.status==='ongoing'?Math.min(1,(Date.now()-r.startedAt)/(r.mins*3000)):r.status==='accepted'?0:null; // محاكاة سريعة للتجربة
const toast=t=>{const e=$('#toast');e.textContent=tr(String(t));e.className='show';setTimeout(()=>e.className='',2600)};
const logo=s=>`<img class="${s?'lg':'biglogo'}" src="logo.jpg" alt="Safe Lady">`;

function mapSVG(a,b,p){const xy=q=>[(q.lng-6.885)/.05*300+10,(36.905-q.lat)/.05*180+10];
let s='<svg viewBox="0 0 320 200"><rect width="320" height="200" fill="#f3e9f0"/><path d="M0 0H320V30Q250 48 190 32T0 42Z" fill="#cfe0f2"/>';
PL.forEach(q=>{const[x,y]=xy(q);s+=`<circle cx="${x}" cy="${y}" r="3" fill="#b79ab0"/><text x="${x+5}" y="${y+3}" font-size="7" fill="#7c6a82">${q.n}</text>`});
if(a!=null&&b!=null&&a!==b){const[x1,y1]=xy(PL[a]),[x2,y2]=xy(PL[b]);
s+=`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#c2468d" stroke-width="3" stroke-dasharray="6 4"/><circle cx="${x1}" cy="${y1}" r="6" fill="#1f9d7a"/><circle cx="${x2}" cy="${y2}" r="6" fill="#4a1d4f"/>`;
if(p!=null)s+=`<text x="${x1+(x2-x1)*p-8}" y="${y1+(y2-y1)*p+6}" font-size="18">🚗</text>`}
return s+'</svg>'}

