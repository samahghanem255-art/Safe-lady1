<form class="row" data-form="chat" data-id="${r.id}" data-me="${me}"><input name="t" placeholder="اكتبي رسالة…" required style="flex:3"><button class="sm">إرسال</button></form>`:'<p class="muted">جارٍ البحث عن سائقة قريبة…</p>'}
${role==='d'&&r.status==='accepted'?`<button class="btn ok" data-act="start" data-id="${r.id}">بدء الرحلة</button>`:''}
${role==='d'&&r.status==='ongoing'?`<button class="btn ok" data-act="end" data-id="${r.id}">إنهاء الرحلة وتحصيل ${money(r.price)}</button>`:''}
${role==='p'?`<div class="row"><button class="sm ghost" data-act="share" data-id="${r.id}">مشاركة الرحلة</button><button class="sm ghost" data-act="report" data-id="${r.id}">إبلاغ عن مشكلة</button>${r.status!=='ongoing'?`<button class="sm ghost" data-act="cancel" data-id="${r.id}">إلغاء</button>`:''}</div>`:''}
${o?`<button class="btn sos" data-act="sos" data-id="${r.id}">SOS طوارئ</button>`:''}</div>`}

const tripsView=(u,k)=>`<div class="card"><h3>سجل الرحلات</h3>${API.rides().filter(r=>r[k]===u.id).map(r=>`<div class="item"><b>${pn(r.from)} ← ${pn(r.to)}</b><small>${fmt(r.created)} · ${money(r.price)} · ${ST[r.status]}${r.ratingD?' · '+stars(r.ratingD.s):''}</small></div>`).join('')||'<p class="muted">لا توجد رحلات بعد.</p>'}</div>`;
const notifView=u=>`<div class="card"><h3>الإشعارات</h3>${API.notifs(u.id).map(n=>`<div class="item">${n.t}<small>${fmt(n.at)}</small></div>`).join('')||'<p class="muted">لا توجد إشعارات.</p>'}</div>`;
const profView=u=>`<div class="card"><h3>الملف الشخصي</h3><form data-form="profile" style="display:grid;gap:10px"><label>الاسم<input name="name" value="${u.name}"></label><label>الهاتف<input name="phone" value="${u.phone||''}"></label>
${u.role==='passenger'?`<label>هاتف الشخص الموثوق (للمشاركة والطوارئ)<input name="trusted" value="${u.trusted||''}"></label>`:`<small>${u.car} · ${u.plate} · تقييمك ${stars(avg(u.id,'ratingD'))}</small>`}<button class="btn">حفظ</button></form></div>
<div class="card"><h3>الدعم</h3><form data-form="support" style="display:grid;gap:10px"><textarea name="t" rows="3" placeholder="اكتبي رسالتك أو شكواك" required></textarea><button class="btn ghost">إرسال للدعم</button></form></div>
<button class="btn ghost" data-act="logout">تسجيل الخروج</button><button class="sm ghost" data-act="reset">إعادة ضبط بيانات التجربة</button>`;

// ---------- الراكبة ----------
function passenger(u){const rs=API.rides().filter(r=>r.passengerId===u.id),
act=rs.find(r=>['searching','accepted','ongoing'].includes(r.status)),un=rs.find(r=>r.status==='completed'&&!r.ratingD);let b;
if(S.tab==='trips')b=tripsView(u,'passengerId');else if(S.tab==='notif')b=notifView(u);else if(S.tab==='me')b=profView(u);
else if(act)b=ridePanel(act,'p');else if(un)b=rateCard(un,'p');
else{const q=S.from!==S.to?API.quote(S.from,S.to):null,op=s=>PL.map((p,i)=>`<option value="${i}" ${s===i?'selected':''}>${p.n}</option>`).join('');
b=`<div class="card map" id="mapbox">${mapSVG(S.from,S.to)}</div><div class="card"><h3>إلى أين؟</h3>
<label>الانطلاق<select data-chg="from">${op(S.from)}</select></label><label>الوجهة<select data-chg="to">${op(S.to)}</select></label>
<div class="seg"><button data-act="when" data-v="now" class="${S.when==='now'?'on':''}">الآن</button><button data-act="when" data-v="later" class="${S.when==='later'?'on':''}">حجز مسبق</button></div>
${S.when==='later'?`<input type="datetime-local" value="${S.date}" data-chg="date">`:''}
${q?`<div class="quote"><b>${money(q.price)}</b><span>≈ ${q.mins} د · ${q.km.toFixed(1)} كم</span></div>`:'<p class="muted">اختاري وجهة مختلفة عن الانطلاق.</p>'}
<label>طريقة الدفع<select><option>نقدًا</option><option disabled>بطاقة إلكترونية (قريبًا)</option></select></label>
<button class="btn" data-act="book" ${q?'':'disabled'}>${S.when==='now'?'اطلبي الآن':'احجزي الرحلة'}</button></div>`}
return shell(u,b,[['home','🏠','الرئيسية'],['trips','🕘','رحلاتي'],['notif','🔔','الإشعارات'],['me','👤','حسابي']])}

// ---------- السائقة ----------
function driver(u){let b;
if(u.status!=='active')b=`<div class="card"><h3>${u.status==='pending'?'حسابك قيد المراجعة':'تعذّر تفعيل الحساب'}</h3><p>${u.status==='pending'?'سنفعّل حسابك بعد موافقة الإدارة على وثائقك.':'تواصلي مع الإدارة.'}</p><button class="btn ghost" data-act="logout">تسجيل الخروج</button></div>`;
else{const rs=API.rides(),act=rs.find(r=>r.driverId===u.id&&['accepted','ongoing'].includes(r.status)),un=rs.find(r=>r.driverId===u.id&&r.status==='completed'&&!r.ratingP);
const mine=rs.filter(r=>r.driverId===u.id&&r.status==='completed'),net=r=>Math.round(r.price*(1-CFG.commission));
if(S.tab==='trips')b=tripsView(u,'driverId');else if(S.tab==='notif')b=notifView(u);else if(S.tab==='me')b=profView(u);
else if(S.tab==='earn')b=`<div class="grid"><div class="stat"><b>${mine.length}</b>رحلات مكتملة</div><div class="stat"><b>${money(mine.reduce((s,r)=>s+net(r),0))}</b>صافي الأرباح</div></div><div class="card"><h3>المدفوعات</h3>${mine.map(r=>`<div class="item"><b>${money(net(r))}</b><small>${fmt(r.endedAt)} · الأجرة ${money(r.price)} · عمولة ${CFG.commission*100}% · نقدًا${r.ratingP?' · '+stars(r.ratingP.s):''}</small></div>`).join('')||'<p class="muted">لا أرباح بعد.</p>'}</div>`;
else if(act)b=ridePanel(act,'d');else if(un)b=rateCard(un,'d');
else{const reqs=u.online?rs.filter(r=>r.status==='searching'&&!r.rejected.includes(u.id)):[];
b=`<div class="card"><div class="quote"><b>${u.online?'متاحة':'غير متاحة'}</b><button class="sm ${u.online?'bad':'ok'}" data-act="online">${u.online?'إيقاف الاستقبال':'بدء الاستقبال'}</button></div></div>
<div class="card"><h3>طلبات الرحلات</h3>${reqs.map(r=>{const p=API.user(r.passengerId);return `<div class="item"><b>${pn(r.from)} ← ${pn(r.to)}</b><small>${p.name} · ${stars(avg(p.id,'ratingP'))} · ${money(r.price)} · ${r.mins} د${r.when?' · '+fmt(r.when):' · فورية'}</small><div class="row"><button class="sm ok" data-act="accept" data-id="${r.id}">قبول</button><button class="sm ghost" data-act="reject" data-id="${r.id}">رفض</button></div></div>`}).join('')||`<p class="muted">${u.online?'لا توجد طلبات الآن.':'فعّلي الاستقبال لرؤية الطلبات.'}</p>`}</div>`}}
return shell(u,b,u.status==='active'?[['home','🚗','الطلبات'],['trips','🕘','رحلاتي'],['earn','💰','الأرباح'],['notif','🔔','الإشعارات'],['me','👤','حسابي']]:null)}

// ---------- الإدارة ----------
function admin(u){document.body.classList.add('wide');const R=API.rides(),P=API.users('passenger'),D=API.users('driver'),C=API.complaints(),done=R.filter(r=>r.status==='completed'),rev=done.reduce((s,r)=>s+r.price,0);
const blk=x=>x.status==='blocked'?`<button class="sm ok" data-act="setst" data-id="${x.id}" data-v="active">إلغاء الحظر</button>`:`<button class="sm bad" data-act="setst" data-id="${x.id}" data-v="blocked">حظر</button>`;
const T={stats:`<div class="grid"><div class="stat"><b>${P.length}</b>الراكبات</div><div class="stat"><b>${D.filter(d=>d.status==='active').length}</b>سائقات معتمدات</div><div class="stat"><b>${D.filter(d=>d.status==='pending').length}</b>بانتظار الموافقة</div><div class="stat"><b>${R.length}</b>إجمالي الرحلات (${done.length} مكتملة)</div><div class="stat"><b>${money(rev)}</b>الإيرادات</div><div class="stat"><b>${money(Math.round(rev*CFG.commission))}</b>عمولة المنصة</div><div class="stat"><b>${C.filter(c=>c.status==='open').length}</b>شكاوى مفتوحة</div></div>`,
pass:`<div class="card">${P.map(p=>`<div class="item"><b>${p.name}</b><small>${p.phone} · ${p.email} · ${R.filter(r=>r.passengerId===p.id).length} رحلة · ${p.status}</small><div>${blk(p)}</div></div>`).join('')||'<p class="muted">لا توجد راكبات.</p>'}</div>`,
drv:`<div class="card">${D.map(d=>`<div class="item"><b>${d.name} — ${d.car} (${d.plate})</b><small>${d.phone} · ${stars(avg(d.id,'ratingD'))} · الحالة: ${d.status}</small><small>الوثائق: ${Object.values(d.docs||{}).join('، ')}</small><div class="row">${d.status!=='active'?`<button class="sm ok" data-act="setst" data-id="${d.id}" data-v="active">موافقة</button>`:''}${d.status==='pending'?`<button class="sm ghost" data-act="setst" data-id="${d.id}" data-v="rejected">رفض</button>`:''}${blk(d)}</div></div>`).join('')}</div>`,
rides:`<div class="card">${R.map(r=>`<div class="item"><b>${pn(r.from)} ← ${pn(r.to)} · ${money(r.price)}</b><small>${fmt(r.created)} · ${API.user(r.passengerId)?.name} / ${API.user(r.driverId)?.name||'—'} · ${ST[r.status]}${r.ratingD?' · تقييم السائقة '+stars(r.ratingD.s)+(r.ratingD.t?' «'+r.ratingD.t+'»':''):''}</small></div>`).join('')||'<p class="muted">لا توجد رحلات.</p>'}</div>`,
comp:`<div class="card">${C.map(c=>`<div class="item"><b>${c.type==='sos'?'🚨 SOS':c.type==='report'?'بلاغ':'دعم'} — ${API.user(c.uid)?.name}</b><span>${c.text}</span><small>${fmt(c.at)}${c.rideId?' · رحلة '+c.rideId:''} · ${c.status}</small>${c.status==='open'?`<div><button class="sm ok" data-act="resolve" data-id="${c.id}">تمت المعالجة</button></div>`:''}</div>`).join('')||'<p class="muted">لا توجد شكاوى.</p>'}</div>`};
const tabs=[['stats','الإحصائيات'],['pass','الراكبات'],['drv','السائقات'],['rides','الرحلات'],['comp','الشكاوى']];
return `<header>${logo('s')}<b>لوحة الإدارة</b><span class="grow"></span>${langSw()}<button class="sm ghost" data-act="logout">خروج</button></header><main><div class="tabs">${tabs.map(([k,l])=>`<button data-act="atab" data-v="${k}" class="${S.atab===k?'on':''}">${l}</button>`).join('')}</div>${T[S.atab]}</main>`}

function render(){const u=API.me();document.body.classList.remove('wide');
app.innerHTML=!u?authView():u.role==='admin'?admin(u):u.role==='driver'?driver(u):passenger(u);applyLang()}

// ---------- الأحداث ----------
const ACT={
mode:b=>{S.mode=b.v},lang:b=>{S.lang=b.v;localStorage.sl_lang=b.v},tab:b=>{S.tab=b.v},atab:b=>{S.atab=b.v},when:b=>{S.when=b.v},star:b=>{S.star=+b.v},
demo:b=>{API.login(b.v,b.v.startsWith('admin')?'admin123':'1234');S.tab='home'},
logout:()=>{API.logout();S.tab='home'},reset:()=>API.reset(),
book:()=>{const u=API.me();if(S.when==='later'&&!S.date)return toast('اختاري تاريخ ووقت الرحلة');
API.book({passengerId:u.id,from:S.from,to:S.to,when:S.when==='later'?new Date(S.date).getTime():null});toast('تم إرسال طلبك')},
cancel:b=>{API.setRide(b.id,{status:'cancelled'});toast('تم إلغاء الرحلة')},
online:()=>{const u=API.me();API.update(u.id,{online:!u.online})},
accept:b=>{const u=API.me(),r=API.ride(b.id);API.setRide(b.id,{status:'accepted',driverId:u.id});API.notify(r.passengerId,`${u.name} قبلت رحلتك (${u.car} · ${u.plate})`)},
reject:b=>{const r=API.ride(b.id);API.setRide(b.id,{rejected:[...r.rejected,API.me().id]})},
start:b=>{API.setRide(b.id,{status:'ongoing',startedAt:Date.now()});API.notify(API.ride(b.id).passengerId,'بدأت رحلتك')},
end:b=>{const r=API.ride(b.id);API.setRide(b.id,{status:'completed',endedAt:Date.now()});API.notify(r.passengerId,`انتهت رحلتك. المبلغ: ${money(r.price)} نقدًا`);S.star=5},
share:b=>{const u=API.me();const t=`تتبّعي رحلتي على Safe Lady: ${location.origin}/track/${b.id}`;navigator.clipboard?.writeText(t);API.notify(u.id,`تمت مشاركة الرحلة مع ${u.trusted||'شخص موثوق'}`);toast(u.trusted?`تم نسخ رابط التتبّع لإرساله إلى ${u.trusted}`:'تم نسخ رابط التتبّع — أضيفي رقمًا موثوقًا في حسابك')},
report:b=>{const t=prompt(tr('صفي المشكلة'));if(t){API.complain({type:'report',rideId:b.id,uid:API.me().id,text:t});toast('تم إرسال بلاغك للإدارة')}},
sos:b=>{if(!confirm(tr('إرسال تنبيه طوارئ للإدارة؟\nللخطر الفوري اتصلي بالشرطة 1548 أو الدرك 1055.')))return;
const u=API.me(),r=API.ride(b.id);API.complain({type:'sos',rideId:b.id,uid:u.id,text:`استغاثة أثناء رحلة ${pn(r.from)} ← ${pn(r.to)}`});API.notify('a1','🚨 تنبيه SOS جديد');toast('تم إرسال تنبيه SOS للإدارة')},
setst:b=>{API.update(b.id,{status:b.v});API.notify(b.id,b.v==='active'?'تم تفعيل حسابك':'تم تغيير حالة حسابك: '+b.v)},
resolve:b=>API.resolve(b.id)};
document.addEventListener('click',e=>{const b=e.target.closest('[data-act]');if(!b)return;try{ACT[b.dataset.act](b.dataset)}catch(x){toast(x)}render()});
document.addEventListener('change',e=>{const k=e.target.dataset.chg;if(!k)return;const v=e.target.value;
if(k==='role')S.role=v;else if(k==='date')S.date=v;else if(k==='from'||k==='to')S[k]=+v;render()});
document.addEventListener('submit',e=>{e.preventDefault();const f=e.target,k=f.dataset.form,d=Object.fromEntries(new FormData(f)),u=API.me();
try{
if(k==='login'){API.login(d.email,d.pass)}
else if(k==='reg'){if(d.role==='driver'){d.docs={license:d.f_license.name,id:d.f_id.name,car:d.f_car.name};delete d.f_license;delete d.f_id;delete d.f_car}API.register(d);S.tab='home'}
else if(k==='chat')API.say(f.dataset.id,f.dataset.me,d.t);
else if(k==='rate'){API.setRide(f.dataset.id,{[f.dataset.role==='p'?'ratingD':'ratingP']:{s:S.star,t:d.t}});toast('شكرًا لتقييمك')}
else if(k==='profile'){API.update(u.id,d);toast('تم الحفظ')}
else if(k==='support'){API.complain({type:'support',uid:u.id,text:d.t});f.reset();toast('وصلت رسالتك للدعم')}
}catch(x){toast(x)}render()});
window.onSync=()=>{if(!document.activeElement.matches('input,textarea,select'))render()};
setInterval(()=>{const m=$('#mapbox[data-rid]');if(!m)return;const r=API.ride(m.dataset.rid);if(r&&r.status==='ongoing'){m.innerHTML=mapSVG(r.from,r.to,prog(r));applyLang(m)}},1000);
render();
