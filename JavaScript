// الدفع: حقل pay في الرحلة ('cash' الآن) — أضيفي مزوّد دفع إلكتروني هنا لاحقًا.
const API=(()=>{
const K='safelady_db',id=()=>Math.random().toString(36).slice(2,9),find=(a,i)=>a.find(x=>x.id===i);
const seed=()=>({users:[
{id:'a1',role:'admin',name:'الإدارة',email:'admin@safelady.dz',pass:'admin123',status:'active'},
{id:'d1',role:'driver',name:'أمينة بن علي',phone:'0550000001',email:'driver@safelady.dz',pass:'1234',status:'active',car:'Renault Symbol',plate:'12345-120-21',docs:{license:'permis.jpg',id:'cni.jpg',car:'carte-grise.jpg'},online:false,created:Date.now()},
{id:'p1',role:'passenger',name:'سارة مرابط',phone:'0660000002',email:'sara@safelady.dz',pass:'1234',status:'active',trusted:'0770000003',created:Date.now()}],
rides:[],complaints:[],notifs:[]});
let db=JSON.parse(localStorage.getItem(K)||'null')||seed();
const save=()=>localStorage.setItem(K,JSON.stringify(db));
addEventListener('storage',e=>{if(e.key===K){db=JSON.parse(e.newValue);window.onSync&&onSync()}});
const km=(a,b)=>{const r=Math.PI/180,x=(b.lat-a.lat)*r,y=(b.lng-a.lng)*r,h=Math.sin(x/2)**2+Math.cos(a.lat*r)*Math.cos(b.lat*r)*Math.sin(y/2)**2;return 12742*Math.asin(Math.sqrt(h))};
const quote=(a,b)=>{const d=km(CFG.places[a],CFG.places[b])*1.3;return{km:d,price:Math.max(CFG.min,Math.round((CFG.base+CFG.perKm*d)/10)*10),mins:Math.max(3,Math.round(d/CFG.speed*60)+2)}};
return{quote,
me:()=>find(db.users,sessionStorage.sid),user:i=>find(db.users,i),users:r=>db.users.filter(u=>u.role===r),
login(email,pass){const u=db.users.find(u=>u.email===email&&u.pass===pass);if(!u)throw'بيانات الدخول غير صحيحة';if(u.status==='blocked')throw'هذا الحساب محظور';sessionStorage.sid=u.id},
logout(){delete sessionStorage.sid},
register(d){if(db.users.some(u=>u.email===d.email))throw'هذا البريد مسجّل مسبقًا';const u={id:id(),status:d.role==='driver'?'pending':'active',created:Date.now(),online:false,...d};db.users.push(u);save();sessionStorage.sid=u.id},
update(i,p){Object.assign(find(db.users,i),p);save()},
rides:()=>db.rides,ride:i=>find(db.rides,i),
book(d){db.rides.unshift({id:id(),status:'searching',created:Date.now(),chat:[],rejected:[],pay:'cash',...d,...quote(d.from,d.to)});save()},
setRide(i,p){Object.assign(find(db.rides,i),p);save()},
say(i,from,t){find(db.rides,i).chat.push({from,t});save()},
notify(uid,t){db.notifs.unshift({id:id(),uid,t,at:Date.now()});save()},notifs:uid=>db.notifs.filter(n=>n.uid===uid),
complain(d){db.complaints.unshift({id:id(),status:'open',at:Date.now(),...d});save()},complaints:()=>db.complaints,
resolve(i){find(db.complaints,i).status='resolved';save()},
reset(){localStorage.removeItem(K);sessionStorage.clear();location.reload()}}})();
